# CC-BY-SA 4.0 — TFG Peluquería
# Copia este fichero como .env y ajusta los valores

# Base de datos
# Puerto 5433 (no 5432) para evitar conflicto si tienes un PostgreSQL nativo
# instalado en el sistema, ya que docker-compose.yml mapea 5433->5432 del contenedor.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=peluqueria
DB_USER=postgres
DB_PASSWORD=changeme

# JWT
JWT_SECRET=cambia_esto_en_produccion
JWT_EXPIRES_IN=7d

# App
PORT=3000
FRONTEND_URL=http://localhost:4200
NODE_ENV=development
